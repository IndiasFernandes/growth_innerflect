---
// Giscus commenting system for collaborative brainstorming
// To enable: Configure with your GitHub repo details and uncomment the script below
// 1. Install Giscus app on your GitHub repo: https://github.com/apps/giscus
// 2. Get your repo ID and category ID from: https://giscus.app
// 3. Update the variables below and uncomment the script

const giscusEnabled = false; // Set to true when Giscus is configured
const repo = "your-username/your-repo"; // Update with actual repo
const repoId = ""; // Will be generated by Giscus
const category = "General";
const categoryId = ""; // Will be generated by Giscus
const mapping = "pathname";
const reactionsEnabled = "1";
const emitMetadata = "0";
const theme = "light";
---

<div class="comments-container">
  <h3 class="comments-title">Share Your Thoughts</h3>
  <p class="comments-description">Leave a comment to brainstorm and collaborate on this section.</p>
  
  {giscusEnabled ? (
    <>
      <div class="giscus"></div>
      <script src="https://giscus.app/client.js"
              data-repo={repo}
              data-repo-id={repoId}
              data-category={category}
              data-category-id={categoryId}
              data-mapping={mapping}
              data-reactions-enabled={reactionsEnabled}
              data-emit-metadata={emitMetadata}
              data-theme={theme}
              crossorigin="anonymous"
              async>
      </script>
    </>
  ) : (
    <div class="comments-placeholder">
      <p class="placeholder-text">
        Comments are coming soon! To enable Giscus commenting:
      </p>
      <ol class="placeholder-steps">
        <li>Install the <a href="https://github.com/apps/giscus" target="_blank" rel="noopener">Giscus app</a> on your GitHub repository</li>
        <li>Get your repository ID and category ID from <a href="https://giscus.app" target="_blank" rel="noopener">giscus.app</a></li>
        <li>Update the configuration in <code>src/components/Comments.astro</code></li>
        <li>Set <code>giscusEnabled = true</code> in the component</li>
      </ol>
      <p class="placeholder-note">
        For now, you can use the contact form or email to share feedback and brainstorm ideas.
      </p>
    </div>
  )}
</div>

<style>
  .comments-container {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-cream-dark);
  }

  .comments-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    margin: 0 0 0.5rem 0;
    color: var(--color-charcoal);
  }

  .comments-description {
    color: var(--color-charcoal-light);
    margin: 0 0 2rem 0;
    font-size: 0.95rem;
  }

  .giscus {
    margin-top: 2rem;
  }

  .comments-placeholder {
    background-color: var(--color-cream-light);
    border: 1px solid var(--color-cream-dark);
    border-radius: 8px;
    padding: 2rem;
    margin-top: 1rem;
  }

  .placeholder-text {
    color: var(--color-charcoal);
    font-weight: 500;
    margin: 0 0 1rem 0;
  }

  .placeholder-steps {
    color: var(--color-charcoal-light);
    line-height: 1.8;
    margin: 0 0 1rem 0;
    padding-left: 1.5rem;
  }

  .placeholder-steps li {
    margin-bottom: 0.5rem;
  }

  .placeholder-steps a {
    color: var(--color-gold);
    text-decoration: none;
    font-weight: 500;
  }

  .placeholder-steps a:hover {
    text-decoration: underline;
  }

  .placeholder-steps code {
    background-color: var(--color-cream-dark);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--color-charcoal);
  }

  .placeholder-note {
    color: var(--color-charcoal-light);
    font-size: 0.95rem;
    font-style: italic;
    margin: 1rem 0 0 0;
  }
</style>

