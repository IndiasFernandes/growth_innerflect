---
// Giscus commenting system for collaborative brainstorming
// To enable: Configure with your GitHub repo details and uncomment the script below
// 1. Install Giscus app on your GitHub repo: https://github.com/apps/giscus
// 2. Get your repo ID and category ID from: https://giscus.app
// 3. Update the variables below and set giscusEnabled = true

const repo = "IndiasFernandes/growth_innerflect"; // Your GitHub repository
const repoId = ""; // Get from https://giscus.app after installing the app
const category = "General";
const categoryId = ""; // Get from https://giscus.app after installing the app
const mapping = "pathname";
const reactionsEnabled = "1";
const emitMetadata = "0";
const theme = "light";

// Only enable if repoId and categoryId are configured
const giscusEnabled = repoId !== "" && categoryId !== "";
---

<div class="comments-container">
  <h3 class="comments-title">Share Your Thoughts</h3>
  <p class="comments-description">Leave a comment to brainstorm and collaborate on this section.</p>
  
  {giscusEnabled ? (
    <>
      <div class="giscus"></div>
      <script src="https://giscus.app/client.js"
              data-repo={repo}
              data-repo-id={repoId}
              data-category={category}
              data-category-id={categoryId}
              data-mapping={mapping}
              data-reactions-enabled={reactionsEnabled}
              data-emit-metadata={emitMetadata}
              data-theme={theme}
              crossorigin="anonymous"
              async>
      </script>
      <noscript>
        <p class="error-message">
          Please enable JavaScript to view comments powered by Giscus.
        </p>
      </noscript>
    </>
  ) : (
    <div class="comments-placeholder">
      <p class="placeholder-text">
        Comments are coming soon! To enable Giscus commenting:
      </p>
      <ol class="placeholder-steps">
        <li>Install the <a href="https://github.com/apps/giscus" target="_blank" rel="noopener">Giscus app</a> on your GitHub repository (<code>{repo}</code>)</li>
        <li>Visit <a href="https://giscus.app" target="_blank" rel="noopener">giscus.app</a> and configure your repository</li>
        <li>Copy your <code>repoId</code> and <code>categoryId</code> from the configuration</li>
        <li>Update the <code>repoId</code> and <code>categoryId</code> values in <code>src/components/Comments.astro</code></li>
        <li>The component will automatically enable once both IDs are configured</li>
      </ol>
      <p class="placeholder-note">
        <strong>Current status:</strong> Repository is set to <code>{repo}</code>, but Giscus app needs to be installed and configured.
      </p>
      <p class="placeholder-note">
        For now, you can use the contact form or email to share feedback and brainstorm ideas.
      </p>
    </div>
  )}
</div>

<style>
  .comments-container {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-cream-dark);
  }

  .comments-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    margin: 0 0 0.5rem 0;
    color: var(--color-charcoal);
  }

  .comments-description {
    color: var(--color-charcoal-light);
    margin: 0 0 2rem 0;
    font-size: 0.95rem;
  }

  .giscus {
    margin-top: 2rem;
  }

  .comments-placeholder {
    background-color: var(--color-cream-light);
    border: 1px solid var(--color-cream-dark);
    border-radius: 8px;
    padding: 2rem;
    margin-top: 1rem;
  }

  .placeholder-text {
    color: var(--color-charcoal);
    font-weight: 500;
    margin: 0 0 1rem 0;
  }

  .placeholder-steps {
    color: var(--color-charcoal-light);
    line-height: 1.8;
    margin: 0 0 1rem 0;
    padding-left: 1.5rem;
  }

  .placeholder-steps li {
    margin-bottom: 0.5rem;
  }

  .placeholder-steps a {
    color: var(--color-gold);
    text-decoration: none;
    font-weight: 500;
  }

  .placeholder-steps a:hover {
    text-decoration: underline;
  }

  .placeholder-steps code {
    background-color: var(--color-cream-dark);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--color-charcoal);
  }

  .placeholder-note {
    color: var(--color-charcoal-light);
    font-size: 0.95rem;
    font-style: italic;
    margin: 1rem 0 0 0;
  }

  .placeholder-note strong {
    color: var(--color-charcoal);
    font-weight: 600;
  }

  .error-message {
    color: #d32f2f;
    background-color: #ffebee;
    border: 1px solid #ef5350;
    border-radius: 4px;
    padding: 1rem;
    margin-top: 1rem;
    font-size: 0.95rem;
  }
</style>

