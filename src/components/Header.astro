---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="nav-container">
    <a href="/" class="logo">
      <span class="logo-text">Innerflect</span>
    </a>
    <ul class="nav-links">
      <li><a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a></li>
      <li><a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a></li>
      <li><a href="/services" class={currentPath === '/services' ? 'active' : ''}>Services</a></li>
      <li><a href="/solutions" class={currentPath.startsWith('/solutions') ? 'active' : ''}>Solutions</a></li>
      <li><a href="/team" class={currentPath === '/team' ? 'active' : ''}>Team</a></li>
    </ul>
  </nav>
</header>

<style>
  .header {
    background-color: var(--color-cream);
    border-bottom: 1px solid var(--color-cream-dark);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
    background-color: rgba(245, 245, 240, 0.95);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    text-decoration: none;
    color: var(--color-charcoal);
  }

  .logo-text {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--color-charcoal);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-links a:hover {
    color: var(--color-gold);
  }

  .nav-links a.active {
    color: var(--color-gold);
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-gold);
  }

  @media (max-width: 768px) {
    .nav-container {
      flex-direction: column;
      gap: 1rem;
      padding: 0 1rem;
    }

    .nav-links {
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
    }

    .nav-links a {
      font-size: 0.9rem;
    }
  }
</style>

