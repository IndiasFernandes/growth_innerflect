---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Comments from '../components/Comments.astro';
---

<BaseLayout title="Services — Innerflect" description="Revenue-focused creative technology services">
  <Hero 
    title="Services That Generate Value"
    subtitle="Every solution we build is designed to drive revenue, improve operations, and create measurable impact"
  />

  <Section class="services-intro">
    <div class="container">
      <div class="intro-content">
        <p class="intro-text">
          Our services are built with one goal in mind: to help your business grow. Each offering is designed 
          to generate revenue, improve efficiency, reduce costs, or increase customer lifetime value. 
          We don't build technology for technology's sake—we build systems that create real business outcomes.
        </p>
      </div>
    </div>
  </Section>

  <Section class="services-section">
    <div class="container">
      <div class="services-grid">
        <div class="service-card">
          <div class="service-header">
            <h2 class="service-title">Custom Software & Digital Experiences</h2>
            <div class="revenue-badge">Revenue Focus</div>
          </div>
          <div class="revenue-highlights">
            <h3 class="revenue-title">How It Generates Revenue:</h3>
            <ul class="revenue-list">
              <li>Increased bookings through optimized conversion funnels</li>
              <li>Higher guest retention via personalized experiences</li>
              <li>Premium pricing opportunities for tailored services</li>
              <li>Recurring engagement through community features</li>
            </ul>
          </div>
          <div class="value-proposition">
            <h3 class="value-title">Value Delivered:</h3>
            <p>Tailored web & mobile apps that drive conversions, AI-powered personalization that increases session time and loyalty, community features that create recurring engagement and reduce churn.</p>
          </div>
          <div class="service-features">
            <h3 class="features-title">What's Included:</h3>
            <ul class="features-list">
              <li>Bespoke web & mobile applications</li>
              <li>AI-powered personalization engines</li>
              <li>Community engagement platforms</li>
              <li>Integration with existing CRM and tools</li>
            </ul>
          </div>
        </div>

        <div class="service-card">
          <div class="service-header">
            <h2 class="service-title">Immersive & Multi-Sensory Installations</h2>
            <div class="revenue-badge">Revenue Focus</div>
          </div>
          <div class="revenue-highlights">
            <h3 class="revenue-title">How It Generates Revenue:</h3>
            <ul class="revenue-list">
              <li>Premium experience pricing for unique installations</li>
              <li>Extended guest stays due to memorable experiences</li>
              <li>Shareable content driving organic marketing</li>
              <li>Differentiation that commands higher rates</li>
            </ul>
          </div>
          <div class="value-proposition">
            <h3 class="value-title">Value Delivered:</h3>
            <p>Interactive tech installations that create memorable, Instagram-worthy moments, AV experiences that enhance perceived value, digital art that differentiates you from competitors and creates lasting brand impressions.</p>
          </div>
          <div class="service-features">
            <h3 class="features-title">What's Included:</h3>
            <ul class="features-list">
              <li>Interactive technology installations</li>
              <li>Spatial audio and visual experiences</li>
              <li>Digital art and creative technology</li>
              <li>Performance and event enhancement</li>
            </ul>
          </div>
        </div>

        <div class="service-card">
          <div class="service-header">
            <h2 class="service-title">Smart Spaces & IoT Integration</h2>
            <div class="revenue-badge">Revenue Focus</div>
          </div>
          <div class="revenue-highlights">
            <h3 class="revenue-title">How It Generates Revenue:</h3>
            <ul class="revenue-list">
              <li>Operational efficiency reducing overhead costs</li>
              <li>Dynamic pricing optimization based on real-time data</li>
              <li>Improved capacity utilization and space optimization</li>
              <li>Energy savings that directly impact profitability</li>
            </ul>
          </div>
          <div class="value-proposition">
            <h3 class="value-title">Value Delivered:</h3>
            <p>Intelligent environment systems that enhance guest satisfaction and reduce energy costs, sensor networks that enable data-driven decisions, venue management that maximizes revenue per square foot.</p>
          </div>
          <div class="service-features">
            <h3 class="features-title">What's Included:</h3>
            <ul class="features-list">
              <li>Adaptive lighting and atmosphere systems</li>
              <li>IoT sensor networks and monitoring</li>
              <li>Smart venue management platforms</li>
              <li>Environmental optimization tools</li>
            </ul>
          </div>
        </div>

        <div class="service-card">
          <div class="service-header">
            <h2 class="service-title">Automation & AI for Efficiency</h2>
            <div class="revenue-badge">Revenue Focus</div>
          </div>
          <div class="revenue-highlights">
            <h3 class="revenue-title">How It Generates Revenue:</h3>
            <ul class="revenue-list">
              <li>Reduced operational overhead through automation</li>
              <li>Increased booking conversion rates via AI assistance</li>
              <li>Predictive revenue optimization</li>
              <li>24/7 customer service without additional staff costs</li>
            </ul>
          </div>
          <div class="value-proposition">
            <h3 class="value-title">Value Delivered:</h3>
            <p>Workflow automation that frees staff for high-value interactions, AI customer service that improves response times and satisfaction, analytics dashboards that reveal revenue opportunities you might have missed.</p>
          </div>
          <div class="service-features">
            <h3 class="features-title">What's Included:</h3>
            <ul class="features-list">
              <li>Intelligent workflow automation</li>
              <li>AI-powered customer service chatbots</li>
              <li>Predictive analytics and reporting</li>
              <li>Revenue optimization dashboards</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Ready to Build Revenue-Generating Systems?</h2>
        <p class="cta-text">Let's discuss which services align with your growth goals.</p>
        <a href="/contact" class="cta-button">Start the Conversation</a>
      </div>
    </div>
  </Section>

  <Section>
    <div class="container">
      <Comments />
    </div>
  </Section>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .services-intro {
    background-color: var(--color-cream-light);
  }

  .intro-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .intro-text {
    font-size: 1.2rem;
    line-height: 1.8;
    color: var(--color-charcoal-light);
    margin: 0;
  }

  .services-section {
    background-color: var(--color-cream);
  }

  .services-grid {
    display: grid;
    gap: 3rem;
    margin-top: 2rem;
  }

  .service-card {
    background-color: var(--color-cream-light);
    border: 1px solid var(--color-cream-dark);
    border-radius: 12px;
    padding: 2.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(26, 26, 26, 0.1);
  }

  .service-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  .service-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2rem;
    margin: 0;
    color: var(--color-charcoal);
    flex: 1;
  }

  .revenue-badge {
    background-color: var(--color-gold);
    color: var(--color-charcoal);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: 'Montserrat', sans-serif;
    white-space: nowrap;
  }

  .revenue-highlights {
    background-color: var(--color-sage-light);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .revenue-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    margin: 0 0 1rem 0;
    color: var(--color-charcoal);
  }

  .revenue-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .revenue-list li {
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    position: relative;
    color: var(--color-charcoal-light);
  }

  .revenue-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-sage-dark);
    font-weight: bold;
  }

  .value-proposition {
    margin-bottom: 1.5rem;
  }

  .value-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    margin: 0 0 0.75rem 0;
    color: var(--color-charcoal);
  }

  .value-proposition p {
    color: var(--color-charcoal-light);
    line-height: 1.7;
    margin: 0;
  }

  .service-features {
    border-top: 1px solid var(--color-cream-dark);
    padding-top: 1.5rem;
  }

  .features-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    margin: 0 0 1rem 0;
    color: var(--color-charcoal);
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .features-list li {
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-charcoal-light);
  }

  .features-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-weight: bold;
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-charcoal) 0%, var(--color-charcoal-light) 100%);
    color: var(--color-cream);
  }

  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
    color: var(--color-cream);
  }

  .cta-text {
    font-size: 1.2rem;
    margin: 0 0 2rem 0;
    color: var(--color-cream);
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    background-color: var(--color-gold);
    color: var(--color-charcoal);
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    font-family: 'Montserrat', sans-serif;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .cta-button:hover {
    background-color: var(--color-gold-light);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .service-card {
      padding: 1.5rem;
    }

    .service-header {
      flex-direction: column;
    }

    .service-title {
      font-size: 1.5rem;
    }

    .features-list {
      grid-template-columns: 1fr;
    }

    .cta-title {
      font-size: 2rem;
    }
  }
</style>

