---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Comments from '../components/Comments.astro';
---

<BaseLayout title="About — Innerflect" description="Our philosophy and approach to creative technology">
  <Hero 
    title="Philosophy & Approach"
    subtitle="From tech solutions to creative technology partnership"
  />

  <Section class="philosophy-section">
    <div class="container">
      <div class="philosophy-content">
        <h2 class="section-title">Our Evolution</h2>
        <div class="evolution-grid">
          <div class="evolution-item">
            <h3 class="evolution-label">FROM</h3>
            <p class="evolution-text">Tech & Solutions Studio</p>
            <ul class="evolution-details">
              <li>Small projects</li>
              <li>Price-focused</li>
              <li>Technical jargon</li>
            </ul>
          </div>
          <div class="evolution-arrow">→</div>
          <div class="evolution-item">
            <h3 class="evolution-label">TO</h3>
            <p class="evolution-text">Creative Technology Partner for Wellness & Arts</p>
            <ul class="evolution-details">
              <li>Enhanced-value projects</li>
              <li>Value-focused</li>
              <li>Poetic, sophisticated language</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section class="value-section">
    <div class="container">
      <div class="value-content">
        <h2 class="section-title centered">Our Value Proposition</h2>
        <div class="value-box">
          <p class="value-text">
            InnerFlect harmonizes technology with your brand's soul, creating bespoke digital and sensory 
            experiences that elevate your space and connect meaningfully with your audience.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Section class="how-we-work-section">
    <div class="container">
      <h2 class="section-title centered">How We Work</h2>
      <div class="work-grid">
        <Card title="Discovery">
          <p>We begin by understanding your brand's essence, your audience, and your unique vision. This isn't about fitting you into a template—it's about crafting something that truly reflects who you are.</p>
        </Card>
        <Card title="Design & Strategy">
          <p>We design systems that balance aesthetic beauty with functional excellence. Every decision is made with both your brand soul and business outcomes in mind.</p>
        </Card>
        <Card title="Development">
          <p>We build with precision, using modern technologies that integrate seamlessly with your existing tools and workflows. No disruption, just enhancement.</p>
        </Card>
        <Card title="Growth & Optimization">
          <p>We don't just deliver and disappear. We help you optimize, iterate, and grow. Our systems evolve with your business, revealing new opportunities over time.</p>
        </Card>
      </div>
    </div>
  </Section>

  <Section class="team-section">
    <div class="container">
      <h2 class="section-title centered">Our Team</h2>
      <p class="team-intro">A collective of creative technologists, designers, and strategists dedicated to building systems with soul.</p>
      <div class="team-grid">
        <div class="team-card">
          <div class="team-avatar"></div>
          <h3 class="team-name">Creative Technologist</h3>
          <p class="team-role">Technology & Innovation</p>
        </div>
        <div class="team-card">
          <div class="team-avatar"></div>
          <h3 class="team-name">Experience Designer</h3>
          <p class="team-role">Design & Strategy</p>
        </div>
        <div class="team-card">
          <div class="team-avatar"></div>
          <h3 class="team-name">Growth Strategist</h3>
          <p class="team-role">Business & Revenue</p>
        </div>
      </div>
    </div>
  </Section>

  <Section>
    <div class="container">
      <Comments />
    </div>
  </Section>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    margin: 0 0 1.5rem 0;
    color: var(--color-charcoal);
  }

  .section-title.centered {
    text-align: center;
  }

  .philosophy-section {
    background-color: var(--color-cream-light);
  }

  .philosophy-content {
    max-width: 1000px;
    margin: 0 auto;
  }

  .evolution-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: center;
    margin-top: 2rem;
  }

  .evolution-item {
    background-color: var(--color-cream);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid var(--color-cream-dark);
  }

  .evolution-label {
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    margin: 0 0 0.5rem 0;
  }

  .evolution-text {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-charcoal);
    margin: 0 0 1rem 0;
  }

  .evolution-details {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .evolution-details li {
    color: var(--color-charcoal-light);
    margin-bottom: 0.5rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .evolution-details li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-sage);
  }

  .evolution-arrow {
    font-size: 2rem;
    color: var(--color-gold);
    font-weight: bold;
  }

  .value-section {
    background-color: var(--color-cream);
  }

  .value-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .value-box {
    background: linear-gradient(135deg, var(--color-sage) 0%, var(--color-sage-light) 100%);
    padding: 3rem;
    border-radius: 12px;
    text-align: center;
  }

  .value-text {
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--color-charcoal);
    margin: 0;
    font-weight: 500;
  }

  .how-we-work-section {
    background-color: var(--color-cream-light);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .team-section {
    background-color: var(--color-cream);
  }

  .team-intro {
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-charcoal-light);
    margin: 0 0 3rem 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .team-card {
    text-align: center;
    background-color: var(--color-cream-light);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid var(--color-cream-dark);
  }

  .team-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-sage) 100%);
    margin: 0 auto 1rem;
  }

  .team-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    color: var(--color-charcoal);
  }

  .team-role {
    color: var(--color-charcoal-light);
    font-size: 0.95rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }

    .evolution-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .evolution-arrow {
      transform: rotate(90deg);
      text-align: center;
    }

    .value-box {
      padding: 2rem;
    }

    .value-text {
      font-size: 1.1rem;
    }

    .work-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

