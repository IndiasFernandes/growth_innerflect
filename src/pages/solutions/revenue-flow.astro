---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Comments from '../../components/Comments.astro';
---

<BaseLayout title="Innerflect Revenue Flow — Strategic Clarity Engine" description="Minimalist AI-powered app for mindful business growth">
  <Hero 
    title="A strategic clarity engine disguised as a dashboard."
    subtitle="Minimalist AI-powered app that helps mindful businesses grow by showing what actually matters — weekly."
  />

  <Section class="overview-section">
    <div class="container">
      <div class="overview-content">
        <p class="overview-text">
          Innerflect Revenue Flow integrates with your existing tools (CRM, sheets, platforms) to extract key growth signals, 
          filter noise, and generate brutal, beautiful reports that cut through complexity.
        </p>
        <div class="insights-grid">
          <div class="insight-box">
            <h3 class="insight-title">What's Working</h3>
            <p>See what's driving growth and doubling down on it.</p>
          </div>
          <div class="insight-box">
            <h3 class="insight-title">What's Leaking</h3>
            <p>Identify revenue gaps and opportunities you're missing.</p>
          </div>
          <div class="insight-box">
            <h3 class="insight-title">What Needs Action — Now</h3>
            <p>Prioritized insights with clear improvement paths.</p>
          </div>
        </div>
        <p class="overview-text">
          Each insight comes with a clear improvement path. Over time, the system becomes an intelligent growth mirror — 
          revealing patterns, surfacing blind spots, and guiding decisions that align with both profit and principle.
        </p>
      </div>
    </div>
  </Section>

  <Section class="what-it-does-section">
    <div class="container">
      <h2 class="section-title centered">What It Does</h2>
      <div class="process-grid">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3 class="step-title">Collects</h3>
          <p class="step-description">Pulls live data from CRMs, revenue tools, campaign reports, etc.</p>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <h3 class="step-title">Processes</h3>
          <p class="step-description">Converts that raw data into coherent insights.</p>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <h3 class="step-title">Clarifies</h3>
          <p class="step-description">Shows founders weekly what's really happening.</p>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <h3 class="step-title">Suggests</h3>
          <p class="step-description">AI-generated recommendations for growth & automation.</p>
        </div>
        <div class="process-step">
          <div class="step-number">5</div>
          <h3 class="step-title">Improves</h3>
          <p class="step-description">Connects to n8n or your tools to implement changes faster.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section class="who-its-for-section">
    <div class="container">
      <h2 class="section-title centered">Who It's For</h2>
      <div class="audience-content">
        <ul class="audience-list">
          <li>Coaches, consultants, service founders, indie tech teams</li>
          <li>Aligned businesses doing €5k–€100k/mo and stuck between noise and clarity</li>
          <li>People who want smart systems, not just pretty dashboards</li>
        </ul>
        <p class="audience-note">
          If you're drowning in data but starving for insights, Revenue Flow is for you.
        </p>
      </div>
    </div>
  </Section>

  <Section class="why-different-section">
    <div class="container">
      <h2 class="section-title centered">Why It's Different</h2>
      <div class="differentiators-grid">
        <div class="differentiator-card">
          <h3 class="differentiator-title">Zen UX</h3>
          <p class="differentiator-text">No clutter. Just clarity. Designed for mental whitespace.</p>
        </div>
        <div class="differentiator-card">
          <h3 class="differentiator-title">Opinionated Insights</h3>
          <p class="differentiator-text">The app speaks. It doesn't ask you to interpret charts.</p>
        </div>
        <div class="differentiator-card">
          <h3 class="differentiator-title">Built for Integration</h3>
          <p class="differentiator-text">Connects to what you already use.</p>
        </div>
        <div class="differentiator-card">
          <h3 class="differentiator-title">Innerflect DNA</h3>
          <p class="differentiator-text">It's not just tech. It's soul-aligned structure.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section class="dashboard-section">
    <div class="container">
      <h2 class="section-title centered">Visual Dashboard Mock</h2>
      <div class="dashboard-mock">
        <div class="dashboard-header">
          <div class="dashboard-title">Revenue Flow</div>
          <div class="dashboard-subtitle">Week of {new Date().toLocaleDateString()}</div>
        </div>
        <div class="dashboard-content">
          <div class="dashboard-insight">
            <div class="insight-icon">✓</div>
            <div class="insight-content">
              <h4 class="insight-label">What's Working</h4>
              <p class="insight-text">Retention up 23% — Premium tier driving growth</p>
            </div>
          </div>
          <div class="dashboard-insight warning">
            <div class="insight-icon">⚠</div>
            <div class="insight-content">
              <h4 class="insight-label">What's Leaking</h4>
              <p class="insight-text">Churn spike in Q2 cohort — needs immediate attention</p>
            </div>
          </div>
          <div class="dashboard-insight action">
            <div class="insight-icon">→</div>
            <div class="insight-content">
              <h4 class="insight-label">Action Needed</h4>
              <p class="insight-text">Automate follow-up sequence for trial users</p>
            </div>
          </div>
        </div>
        <div class="dashboard-footer">
          <p class="dashboard-note">Minimalist design. Maximum clarity.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section class="taglines-section">
    <div class="container">
      <div class="taglines-grid">
        <p class="tagline">Business clarity, without the noise.</p>
        <p class="tagline">Your weekly truth. No fluff.</p>
        <p class="tagline">Know. Decide. Grow.</p>
        <p class="tagline">Built to help conscious businesses grow without bullshit.</p>
      </div>
    </div>
  </Section>

  <Section>
    <div class="container">
      <Comments />
    </div>
  </Section>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    margin: 0 0 3rem 0;
    color: var(--color-charcoal);
  }

  .section-title.centered {
    text-align: center;
  }

  .overview-section {
    background-color: var(--color-cream-light);
  }

  .overview-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .overview-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-charcoal-light);
    margin: 0 0 2rem 0;
  }

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .insight-box {
    background-color: var(--color-cream);
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid var(--color-gold);
  }

  .insight-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    color: var(--color-charcoal);
  }

  .insight-box p {
    margin: 0;
    color: var(--color-charcoal-light);
    font-size: 0.95rem;
  }

  .what-it-does-section {
    background-color: var(--color-cream);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .process-step {
    text-align: center;
    padding: 2rem;
    background-color: var(--color-cream-light);
    border-radius: 12px;
    border: 1px solid var(--color-cream-dark);
  }

  .step-number {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-sage) 100%);
    color: var(--color-charcoal);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    margin: 0 auto 1rem;
  }

  .step-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    margin: 0 0 0.75rem 0;
    color: var(--color-charcoal);
  }

  .step-description {
    color: var(--color-charcoal-light);
    margin: 0;
    line-height: 1.6;
  }

  .who-its-for-section {
    background-color: var(--color-cream-light);
  }

  .audience-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .audience-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
  }

  .audience-list li {
    padding: 1rem;
    margin-bottom: 0.75rem;
    background-color: var(--color-cream);
    border-left: 4px solid var(--color-sage);
    border-radius: 4px;
    color: var(--color-charcoal-light);
  }

  .audience-note {
    font-style: italic;
    color: var(--color-charcoal-light);
    text-align: center;
    margin: 0;
    font-size: 1.1rem;
  }

  .why-different-section {
    background-color: var(--color-cream);
  }

  .differentiators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .differentiator-card {
    background-color: var(--color-cream-light);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid var(--color-cream-dark);
    text-align: center;
  }

  .differentiator-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    margin: 0 0 1rem 0;
    color: var(--color-gold);
  }

  .differentiator-text {
    color: var(--color-charcoal-light);
    margin: 0;
    line-height: 1.7;
  }

  .dashboard-section {
    background-color: var(--color-cream-light);
  }

  .dashboard-mock {
    max-width: 800px;
    margin: 0 auto;
    background-color: var(--color-cream);
    border: 1px solid var(--color-cream-dark);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 8px 24px rgba(26, 26, 26, 0.1);
  }

  .dashboard-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-cream-dark);
  }

  .dashboard-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2rem;
    margin: 0 0 0.5rem 0;
    color: var(--color-charcoal);
  }

  .dashboard-subtitle {
    color: var(--color-charcoal-light);
    font-size: 0.95rem;
  }

  .dashboard-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .dashboard-insight {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--color-cream-light);
    border-radius: 8px;
    border-left: 4px solid var(--color-sage);
  }

  .dashboard-insight.warning {
    border-left-color: var(--color-gold);
  }

  .dashboard-insight.action {
    border-left-color: var(--color-charcoal);
  }

  .insight-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-sage-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .dashboard-insight.warning .insight-icon {
    background-color: var(--color-gold);
  }

  .dashboard-insight.action .insight-icon {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
  }

  .insight-content {
    flex: 1;
  }

  .insight-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    margin: 0 0 0.5rem 0;
    color: var(--color-charcoal);
  }

  .insight-text {
    margin: 0;
    color: var(--color-charcoal-light);
    line-height: 1.6;
  }

  .dashboard-footer {
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-cream-dark);
  }

  .dashboard-note {
    font-style: italic;
    color: var(--color-charcoal-light);
    font-size: 0.9rem;
    margin: 0;
  }

  .taglines-section {
    background-color: var(--color-cream);
  }

  .taglines-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    text-align: center;
  }

  .tagline {
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-charcoal);
    margin: 0;
    font-style: italic;
    padding: 1.5rem;
    background-color: var(--color-cream-light);
    border-radius: 8px;
    border: 1px solid var(--color-cream-dark);
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-charcoal) 0%, var(--color-charcoal-light) 100%);
    color: var(--color-cream);
  }

  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
    color: var(--color-cream);
  }

  .cta-text {
    font-size: 1.2rem;
    margin: 0 0 2rem 0;
    color: var(--color-cream);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    padding: 1rem 2.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-family: 'Montserrat', sans-serif;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .cta-button.primary {
    background-color: var(--color-gold);
    color: var(--color-charcoal);
  }

  .cta-button.primary:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .cta-button.secondary {
    background-color: transparent;
    color: var(--color-cream);
    border: 2px solid var(--color-gold);
  }

  .cta-button.secondary:hover {
    background-color: var(--color-gold);
    color: var(--color-charcoal);
  }

  .cta-button.secondary:not(:hover) {
    color: var(--color-cream);
    border-color: var(--color-gold);
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }

    .insights-grid,
    .process-grid,
    .differentiators-grid,
    .taglines-grid {
      grid-template-columns: 1fr;
    }

    .dashboard-mock {
      padding: 1.5rem;
    }

    .cta-title {
      font-size: 2rem;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .cta-button {
      width: 100%;
    }
  }
</style>

